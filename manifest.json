{
  "manifest_version": 3,
  "name": "IMPROV",
  "version": "1.0",
  "description": "Highlight text, run AI prompt, replace inline.",
  "web_accessible_resources": [{"resources": ["assets/logo.png"], "matches": ["<all_urls>"]}],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IMPROV — Run on clipboard"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+I",
        "mac": "Command+Shift+I"
      },
      "description": "Open IMPROV (run on clipboard)"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "options_page": "options.html"
}
